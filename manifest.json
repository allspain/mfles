{
  "manifest_version": 3,
  "name": "MFL Enhancement Suite",
  "version": "1.0.0",
  "description": "Lineup optimizer and position OVR display for playmfl.com",
  "icons": {
    "16":  "icons/16.png",
    "48":  "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.playmfl.com/*"
  ],
  "action": {
    "default_title": "MFL Enhancement Suite",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/16.png",
      "48":  "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.playmfl.com/*", "https://mfl-es.web.app/*"],
      "js": ["fetch_interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.playmfl.com/*", "https://mfl-es.web.app/*"],
      "js": [
        "src/features.js",
        "src/migrations.js",
        "src/settings-sync.js",
        "src/settings.js",
        "content_script.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
